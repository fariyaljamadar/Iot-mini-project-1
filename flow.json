  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "tab_classroom",
    "name": "classroom/data",
    "topic": "classroom/data",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "mqtt_broker_1",
    "nl": false,
