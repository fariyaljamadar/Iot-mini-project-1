  {
    "id": "json1",
    "type": "json",
    "z": "tab_classroom",
    "name": "parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 310,
    "y": 200,
    "wires": [
      [
        "func1"
      ]
    ]
  },
  {
    "id": "func1",
    "type": "function",
    "z": "tab_classroom",
    "name": "Process & decide",
    "func": "// Input: JSON from classroom/data -> {people,temp,hum,lux,light,fan,confidence,mode}\nconst d = msg.payload;\nconst occupied = d.people > 0;\nconst now = Date.now();\n\nconst m1 = { payload: d.temp };\nconst m2 = { payload: d.hum };\nconst m3 = { payload: d.lux };\nconst m4 = { payload: (occupied ? \"OCCUPIED\" : \"EMPTY\") + \" (AI confidence \" + d.confidence + \"%)\" };\nconst m5 = { payload: \"Light: \" + (d.light ? \"ON\" : \"OFF\") + \" | Fan: \" + (d.fan ? \"ON\" : \"OFF\") + \" | Mode: \" + d.mode };\nconst m6 = { topic: \"Occupancy\", payload: occupied ? 1 : 0 };\n\n// Safety rule: if the room is EMPTY but an appliance is still ON, ask the ESP32 to switch it OFF\nlet action = \"NONE\";\nif (!occupied && d.mode === \"auto\" && (d.light || d.fan)) { action = \"FORCE_OFF\"; }\nconst m7 = { payload: { action: action } };\n\nreturn [m1, m2, m3, m4, m5, m6, m7];",
    "outputs": 7,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 200,
    "wires": [
      [
        "ui_temp"
      ],
      [
        "ui_hum"
      ],
      [
        "ui_lux"
      ],
      [
        "ui_occ"
      ],
      [
        "ui_app"
      ],
      [
        "ui_trend"
      ],
      [
        "switch1"
      ]
    ]
  },
